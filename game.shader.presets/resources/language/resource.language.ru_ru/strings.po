#~ msgctxt "#30002"
#~ msgid "Replicates the 2.6-inch dot matrix screen of the Game Boy. Features the ghosting problems of the original handheld."
#~ msgstr "Повторяет 2.6-дюймовый матричный экран Game Boy. Включает эффект гостинга как и в оригинальной консоли."

#~ msgctxt "#30005"
#~ msgid "Emulates a CRT display. Features scan-lines, color correction, gamma correction and sharpening."
#~ msgstr "Повторяет ЭЛТ монитор. Включает линии развёртки, цветокоррекцию, гамма коррекцию и резкость."

#~ msgctxt "#30007"
#~ msgid "Emulates a CRT display. Features scan-lines, color correction, gamma correction, sharpening, CRT phosphor and CRT beam effects."
#~ msgstr "Повторяет ЭЛТ монитор. Включает линии развёртки, цветокоррекцию, гамма коррекцию, резкость, ЭЛТ-люминофор и эффекты лучей ЭЛТ."

#~ msgctxt "#30012"
#~ msgid "Replicates an analog signal through a coaxial RF connector. Features color distortion, blurring, NTSC color artifacts and dot crawl."
#~ msgstr "Повторяет аналоговый сигнал через коксиальный RF выход. Включает искажение цвета, размытие, и другие цветовые артефакты NTSC."

#~ msgctxt "#30015"
#~ msgid "Replicates an analog signal through an S-Video connector. Features color distortion, blurring, NTSC color artifacts."
#~ msgstr "Повторяе аналоговый сигнал через выход S-Video. Включает искажение цвета, размытие, и цветовые артефакты NTSC."

#~ msgctxt "#30016"
#~ msgid "Replicates an analog signal through a composite connector. Features color distortion, blurring, NTSC color artifacts."
#~ msgstr "Повторяет аналоговый сигнал через композитный выход. Включает искажение цвета, размытие, и цветовые артефакты NTSC."

#~ msgctxt "#30020"
#~ msgid "Smooths and rounds edges to reduce pixelation. Written by Hyllian."
#~ msgstr "Сглаживает и округляет края, чтобы уменьшить пикселизацию. Автор: Hyllian."

#~ msgctxt "#30022"
#~ msgid "Smooths and rounds edges to reduce pixelation. Image is smoother than other versions. Written by Hyllian."
#~ msgstr "Сглаживает и округляет края, чтобы уменьшить пикселизацию. Изображение более плавное, чем в других версиях. Автор: Hyllian."

#~ msgctxt "#30025"
#~ msgid "Smooths and rounds edges to reduce pixelation. Written by Derek Liauw Kie Fa."
#~ msgstr "Сглаживает и округляет края, чтобы уменьшить пикселизацию. Автор: Derek Liauw Kie Fa."

#~ msgctxt "#30029"
#~ msgid "Replicates the 4.3-inch LCD screen of the PlayStation Portable."
#~ msgstr "Повторяет 4.3-дюймовый LCD экран PlayStation Portable."

#~ msgctxt "#30030"
#~ msgid "Replecates the 3-inch LCD screen of the Nintendo DS."
#~ msgstr "Повторяет 3-дюймовый LCD экран Nintendo DS."

#~ msgctxt "#30031"
#~ msgid "Replicates the 2.9-inch color LCD screen of the Game Boy Advance."
#~ msgstr "Повторяет 2.9-дюймовый LCD экран Game Boy Advance."

#~ msgctxt "#30034"
#~ msgid "Simulates an LCD screen. Written by Gigaherz."
#~ msgstr "Повторяет LCD экран. Автор: Gigaherz."
