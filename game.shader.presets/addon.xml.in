<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon
  id="game.shader.presets"
  version="22.0.0"
  name="Shader Preset Support"
  provider-name="Team Kodi">
  <requires>@ADDON_DEPENDS@</requires>
  <extension
    point="kodi.shader.presets"
    library_@PLATFORM@="@LIBRARY_FILENAME@"
    extensions="cgp|glslp|hlslp"/>
  <extension point="xbmc.addon.metadata">
    <platform>@PLATFORM@</platform>
    <license>GPL-3.0-or-later</license>
    <source>https://github.com/kodi-game/game.shader.presets</source>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.jpg</fanart>
    </assets>
    <summary lang="en_GB">Shader Preset Support</summary>
    <summary lang="es_ES">Soporte de Preajustes de Sombreado</summary>
    <summary lang="sv_SE">Stöd för shader-förval</summary>
    <summary lang="zh_CN">着色器预设支持</summary>
    <description lang="en_GB">This library provides support for libretro meta shaders.</description>
    <description lang="es_ES">Esta librería soporta meta-sombreados de libretro.</description>
    <description lang="sv_SE">Detta bibliotek ger stöd för libretros meta-shaders.</description>
    <description lang="zh_CN">该库支持 libretro 元着色器。</description>
  </extension>
</addon>
